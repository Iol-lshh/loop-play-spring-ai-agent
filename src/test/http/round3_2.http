### [T7] "그거 취소해주세요" ← "그거" = 2024-1235
### 판정: 1235 언급이면 성공
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: {{session}}

{"message": "그거 취소해주세요"}

>>! ./output/r3-2-{{session}}-t7/{{$timestamp}}.json

> {%
client.test("200 OK", function() { client.assert(response.status === 200); });
var resolved = response.body.includes("1235") || response.body.includes("취소");
client.log(JSON.stringify({ turn: 7, session: "{{session}}", pronoun_resolved: resolved, body: response.body }));
%}

