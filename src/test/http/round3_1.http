@baseUrl = http://localhost:8080

### ======================================================
### Round 3 — 1단계: ChatMemory 3레이어 + X-Session-Id + 지시 대명사 시나리오
###
### 실행 전 주의:
###   - 앱이 기동되어 있어야 함 (./gradlew bootRun)
###   - 시나리오 간 상태가 누적됨. 초기화하려면 DELETE /session/{id} 먼저 실행
###   - 시나리오 4는 독립 세션(cust-B)이므로 순서 무관
###   - 시나리오 5는 cust-C 세션을 새로 생성하므로 순서 무관
### ======================================================


### ======================================================
### [시나리오-1] 지시 대명사 해결 — 2회차에서 1234를 재호출
### 순서: 1-1 → 1-2 → 1-memory
### 기대: 2회차 응답에서 2024-1234 관련 도착 시간을 주문번호 없이 답해야 함
### ======================================================

### [S1-1] cust-A 첫 번째 — 주문번호 명시
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-A

{"message": "2024-1234 어디쯤 있어요?"}

>>! ./output/r3-1-s1-1/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("배달 위치 응답", function() {
    client.assert(
        response.body.includes("역삼역") || response.body.includes("배달") || response.body.includes("도착"),
        "배달 위치 응답이 없음"
    );
});
client.log(JSON.stringify({ scenario: "S1-1", body: response.body }));
%}

### [S1-2] cust-A 두 번째 — 지시 대명사 "그거"
### 기대: Memory에서 2024-1234 추출 → getDeliveryStatus(2024-1234) 재호출 → 도착 시간 응답
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-A

{"message": "그거 언제 도착해요?"}

>>! ./output/r3-1-s1-2/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("주문번호 재질문 없음 (Memory 해결)", function() {
    client.assert(
        !response.body.includes("주문번호를") && !response.body.includes("어떤 주문"),
        "응답이 주문번호를 다시 물어봄 — Memory 지시 대명사 해결 실패"
    );
});
client.log(JSON.stringify({ scenario: "S1-2", body: response.body }));
%}

### [S1-memory] cust-A Memory 상태 확인
GET {{baseUrl}}/api/v1/session/cust-A/messages

>>! ./output/r3-1-s1-memory/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("USER/ASSISTANT 메시지 쌍 존재", function() {
    var body = JSON.parse(response.body);
    client.assert(body.length >= 4, "메시지가 4개 미만");
    var userMsgs = body.filter(function(m) { return m.type === "USER"; });
    var asstMsgs = body.filter(function(m) { return m.type === "ASSISTANT"; });
    client.assert(userMsgs.length >= 2 && asstMsgs.length >= 2, "USER/ASSISTANT 쌍 부족");
});
client.log(JSON.stringify({ scenario: "S1-memory", count: JSON.parse(response.body).length }));
%}


### ======================================================
### [시나리오-2] 취소 대상 전환 — "아, 그거 말고 1235 취소해주세요"
### 순서: 2-1 → 2-2 → 2-memory
### 기대: 2회차에서 취소 대상이 1235로 전환되어야 함
### ======================================================

### [S2-1] cust-A — 1234 취소 요청
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-A

{"message": "2024-1234 취소해주세요"}

>>! ./output/r3-1-s2-1/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("취소 처리 응답", function() {
    client.assert(response.body.includes("취소"), "취소 관련 응답 없음");
});
client.log(JSON.stringify({ scenario: "S2-1", body: response.body }));
%}

### [S2-2] cust-A — "아, 그거 말고 1235 취소해주세요" (대상 전환)
### 기대: 1234 취소를 철회하고 1235를 취소 처리
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-A

{"message": "아, 그거 말고 2024-1235 취소해주세요"}

>>! ./output/r3-1-s2-2/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("1235 취소 처리 (대상 전환 성공)", function() {
    client.assert(
        response.body.includes("1235") || response.body.includes("취소"),
        "1235 취소 응답이 없음 — 대상 전환 실패"
    );
});
client.log(JSON.stringify({ scenario: "S2-2", body: response.body }));
%}

### [S2-memory] cust-A Memory 상태 확인 (누적)
GET {{baseUrl}}/api/v1/session/cust-A/messages

>>! ./output/r3-1-s2-memory/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.log(JSON.stringify({ scenario: "S2-memory", count: JSON.parse(response.body).length }));
%}


### ======================================================
### [시나리오-3] 이전 턴 orderId 참조 — "아까 물어본 그 주문"
### 순서: 3-1 (cust-A에 1234 맥락이 이미 있으므로 바로 실행)
### 기대: Memory에서 이전 턴의 2024-1234를 추출해 응답
### ======================================================

### [S3-1] cust-A — "아까 물어본 그 주문 언제 도착해요?"
### cust-A 세션에 이미 1234 맥락이 쌓여 있으므로 바로 실행
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-A

{"message": "아까 물어본 그 주문 언제 도착해요?"}

>>! ./output/r3-1-s3-1/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("이전 orderId 추출 — 주문번호 재질문 없음", function() {
    client.assert(
        !response.body.includes("주문번호를") && !response.body.includes("어떤 주문"),
        "응답이 주문번호를 다시 물어봄 — Memory에서 orderId 추출 실패"
    );
});
client.log(JSON.stringify({ scenario: "S3-1", body: response.body }));
%}


### ======================================================
### [시나리오-4] 세션 오염 테스트 — cust-B는 cust-A 맥락을 알 수 없어야 함
### 순서: 4-1 → 4-memory → 4-ids
### 기대: cust-B 응답에서 "어떤 주문"을 되묻거나 주문번호를 요청해야 함
### ======================================================

### [S4-1] cust-B — 맥락 없이 "그 주문 어디쯤이에요?"
### cust-B는 아무 대화 이력이 없으므로 맥락을 못 찾아야 함
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-B

{"message": "그 주문 어디쯤이에요?"}

>>! ./output/r3-1-s4-1/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("세션 분리 — cust-A 맥락 미유출 (주문번호 재질문)", function() {
    client.assert(
        response.body.includes("주문번호") || response.body.includes("어떤 주문") || response.body.includes("알려주"),
        "cust-B가 맥락을 찾았음 — 세션 오염 가능성"
    );
});
client.log(JSON.stringify({ scenario: "S4-1", body: response.body }));
%}

### [S4-memory] cust-B Memory 상태 — cust-A 메시지가 없어야 함
GET {{baseUrl}}/api/v1/session/cust-B/messages

>>! ./output/r3-1-s4-memory/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("cust-B Memory에 cust-A 내용 없음", function() {
    var body = JSON.parse(response.body);
    var hasA = body.some(function(m) {
        return m.content.includes("2024-1234") && m.type === "USER";
    });
    client.assert(!hasA, "cust-B Memory에 2024-1234 USER 메시지가 존재 — 세션 오염 의심");
});
client.log(JSON.stringify({ scenario: "S4-memory", count: JSON.parse(response.body).length }));
%}

### [S4-ids] 등록된 세션 ID 목록 — cust-A 와 cust-B가 분리 등록되어야 함
GET {{baseUrl}}/api/v1/session/ids

>>! ./output/r3-1-s4-ids/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("cust-A 세션 등록", function() {
    var body = JSON.parse(response.body);
    client.assert(body.includes("cust-A"), "cust-A 세션이 목록에 없음");
});
client.test("cust-B 세션 등록", function() {
    var body = JSON.parse(response.body);
    client.assert(body.includes("cust-B"), "cust-B 세션이 목록에 없음");
});
client.log(JSON.stringify({ scenario: "S4-ids", sessions: JSON.parse(response.body) }));
%}


### ======================================================
### [시나리오-5] Memory 삭제 후 맥락 소멸 검증
### 순서: 5-1 → 5-before-memory → 5-delete → 5-after-memory → 5-2
### 기대: DELETE 이후 "그거" 질문 → 주문번호 재질문 (맥락 없음)
### ======================================================

### [S5-1] cust-C — 1234 언급
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-C

{"message": "2024-1234 배달 상태 알려주세요"}

>>! ./output/r3-1-s5-1/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.log(JSON.stringify({ scenario: "S5-1", body: response.body }));
%}

### [S5-before-memory] DELETE 전 cust-C Memory 상태 확인
GET {{baseUrl}}/api/v1/session/cust-C/messages

>>! ./output/r3-1-s5-before/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("삭제 전 메시지 존재", function() {
    var body = JSON.parse(response.body);
    client.assert(body.length > 0, "삭제 전인데 Memory가 비어 있음");
});
client.log(JSON.stringify({ scenario: "S5-before", count: JSON.parse(response.body).length }));
%}

### [S5-delete] cust-C Memory 삭제
DELETE {{baseUrl}}/api/v1/session/cust-C

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.log(JSON.stringify({ scenario: "S5-delete", status: response.status }));
%}

### [S5-after-memory] DELETE 후 cust-C Memory 상태 — 비어 있어야 함
GET {{baseUrl}}/api/v1/session/cust-C/messages

>>! ./output/r3-1-s5-after/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("삭제 후 Memory 비어 있음", function() {
    var body = JSON.parse(response.body);
    client.assert(body.length === 0, "삭제 후에도 메시지가 남아 있음 — DELETE 미동작");
});
client.log(JSON.stringify({ scenario: "S5-after", count: JSON.parse(response.body).length }));
%}

### [S5-2] cust-C — 삭제 후 "그거" 질문 → 맥락 없음 확인
### 기대: Memory가 비어 있으므로 주문번호를 되물어야 함
POST {{baseUrl}}/api/v1/assistant
Content-Type: application/json
X-Session-Id: cust-C

{"message": "그거 언제 도착해요?"}

>>! ./output/r3-1-s5-2/{{$timestamp}}.json

> {%
client.test("200 OK", function() {
    client.assert(response.status === 200, "status must be 200");
});
client.test("삭제 후 맥락 없음 — 주문번호 재질문", function() {
    client.assert(
        response.body.includes("주문번호") || response.body.includes("어떤 주문") || response.body.includes("알려주"),
        "삭제 후에도 맥락을 찾음 — Memory 삭제가 반영되지 않았을 수 있음"
    );
});
client.log(JSON.stringify({ scenario: "S5-2", body: response.body }));
%}
